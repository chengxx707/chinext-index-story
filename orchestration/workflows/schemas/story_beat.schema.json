{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story_beat",
  "description": "单一读点的候选叙事节拍及可回查的来源。",
  "type": "object",
  "required": [
    "beat_id",
    "period_id",
    "market_anchor",
    "market_close",
    "story_purpose",
    "primary_focus",
    "classification",
    "event_ids",
    "source_ids",
    "source_line",
    "screen_text",
    "causal_claim"
  ],
  "properties": {
    "beat_id": {
      "type": "string",
      "minLength": 1
    },
    "period_id": {
      "type": "string",
      "minLength": 1
    },
    "market_anchor": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "market_close": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "story_purpose": {
      "type": "string",
      "minLength": 1
    },
    "primary_focus": {
      "type": "string",
      "enum": [
        "market",
        "close_extremum",
        "intraday_extremum",
        "event",
        "attributed_voice",
        "gap"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "fact",
        "interpretation",
        "hypothesis",
        "opinion"
      ]
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_line": {
      "type": "string",
      "minLength": 1
    },
    "screen_text": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 4
    },
    "causal_claim": {
      "const": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF-01A research execution manifest",
  "type": "object",
  "required": ["schema_version", "workflow", "period_id", "generated_at", "inputs", "outputs", "evidence_counts", "network_requests", "production_registry_modified"],
  "properties": {
    "schema_version": {"const": 1},
    "workflow": {"const": "WF-01A"},
    "period_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "inputs": {"type": "array"},
    "outputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "evidence_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "network_requests": {"const": 0},
    "production_registry_modified": {"const": false}
  }
}

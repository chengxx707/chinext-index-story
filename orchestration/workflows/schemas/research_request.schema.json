{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF-01A external research request",
  "type": "object",
  "required": ["schema_version", "period", "questions", "return_schema", "prompt", "response_path"],
  "properties": {
    "schema_version": {"const": 1},
    "period": {"type": "object", "required": ["id", "title", "start_date", "end_date", "timezone"]},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "required_evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "search_terms": {"type": "array", "items": {"type": "string"}},
          "authoritative_avenues": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "return_schema": {"const": "return.schema.json"},
    "prompt": {"const": "research_request.md"},
    "response_path": {"type": "string", "minLength": 1}
  }
}
